{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.example/schemas/h3-request.schema.json",
  "title": "Canonical H3 request and reference manifest",
  "type": "object",
  "required": ["prompt", "duration", "ratio", "resolution", "provider_profile"],
  "properties": {
    "provider": {"const": "autodl"},
    "production_contract": {"enum": ["agent-know-gold-v1"]},
    "prompt": {"type": "string", "minLength": 1, "maxLength": 7000},
    "duration": {"type": "integer", "minimum": 4, "maximum": 15},
    "ratio": {"enum": ["adaptive", "21:9", "16:9", "4:3", "1:1", "3:4", "9:16"]},
    "resolution": {"enum": ["768P", "4K"]},
    "provider_profile": {"enum": ["fast", "precision_keyframes", "ref_multimodal", "fl2v_explicit", "precision_timed", "precision_timed_h3keyframes", "refine_2pass_exp", "refine_2pass_int8_exp"]},
    "audio_policy": {"enum": ["sfx_only", "scripted_music"], "default": "sfx_only"},
    "seed": {"type": "integer", "minimum": 0},
    "experimental_canary": {"type": "boolean"},
    "refine_pass2_model": {"enum": ["minimax_h3_fl2va_pruned_w4a8_mixed.safetensors", "minimax_h3_fl2va_int8_convrot.safetensors"]},
    "refine_pass2_steps": {"const": 3},
    "refine_pass2_denoise": {"const": 0.25},
    "refine_pass2_scale": {"const": 2},
    "media": {"type": "array", "items": {"$ref": "#/$defs/reference"}},
    "reference_manifest": {
      "type": "object",
      "required": ["schema_version", "assets"],
      "properties": {
        "schema_version": {"const": "1.0"},
        "assets": {"type": "array", "items": {"$ref": "#/$defs/reference"}}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"production_contract": {"const": "agent-know-gold-v1"}}, "required": ["production_contract"]},
      "then": {
        "required": ["provider", "audio_policy", "media"],
        "properties": {
          "provider": {"const": "autodl"},
          "resolution": {"const": "4K"},
          "provider_profile": {"const": "precision_keyframes"},
          "audio_policy": {"const": "sfx_only"},
          "prompt": {"type": "string", "minLength": 1, "maxLength": 1600},
          "media": {"type": "array", "minItems": 3, "maxItems": 5, "items": {"$ref": "#/$defs/reference"}}
        }
      }
    },
    {
      "if": {"properties": {"provider": {"const": "autodl"}}, "required": ["provider"]},
      "then": {
        "required": ["provider"],
        "properties": {"provider_profile": {"enum": ["fast", "precision_keyframes"]}}
      }
    },
    {
      "if": {"properties": {"provider_profile": {"const": "precision_timed_h3keyframes"}}, "required": ["provider_profile"]},
      "then": {
        "properties": {
          "media": {
            "type": "array",
            "minItems": 2,
            "maxItems": 6,
            "items": {
              "allOf": [
                {"$ref": "#/$defs/reference"},
                {
                  "properties": {"role": {"const": "reference_image"}},
                  "oneOf": [
                    {"required": ["anchor_time_ms"], "not": {"required": ["frame_index"]}},
                    {"required": ["frame_index"], "not": {"required": ["anchor_time_ms"]}}
                  ]
                }
              ]
            }
          }
        },
        "required": ["media"]
      }
    },
    {
      "if": {"properties": {"provider_profile": {"const": "refine_2pass_exp"}}, "required": ["provider_profile"]},
      "then": {
        "required": ["refine_pass2_model", "refine_pass2_steps", "refine_pass2_denoise", "refine_pass2_scale"],
        "properties": {
          "resolution": {"const": "4K"},
          "refine_pass2_model": {"const": "minimax_h3_fl2va_pruned_w4a8_mixed.safetensors"},
          "media": {
            "type": "array",
            "minItems": 1,
            "maxItems": 2,
            "items": {"$ref": "#/$defs/reference"}
          }
        }
      }
    },
    {
      "if": {"properties": {"provider_profile": {"const": "refine_2pass_int8_exp"}}, "required": ["provider_profile"]},
      "then": {
        "required": ["refine_pass2_model", "refine_pass2_steps", "refine_pass2_denoise", "refine_pass2_scale", "experimental_canary"],
        "properties": {
          "resolution": {"const": "4K"},
          "refine_pass2_model": {"const": "minimax_h3_fl2va_int8_convrot.safetensors"},
          "experimental_canary": {"const": true},
          "duration": {"const": 6},
          "ratio": {"const": "4:3"},
          "media": {"type": "array", "minItems": 1, "maxItems": 2, "items": {"$ref": "#/$defs/reference"}}
        }
      }
    }
  ],
  "$defs": {
    "reference": {
      "type": "object",
      "required": ["source", "role"],
      "properties": {
        "source": {"type": "string", "minLength": 1},
        "role": {"enum": ["first_frame", "last_frame", "reference_image", "reference_video", "reference_audio"]},
        "source_origin": {"type": "string"},
        "rights_note": {"type": "string"},
        "semantic_role": {"enum": ["object_material", "scene", "style", "action", "camera", "sound", "first_frame", "keyframe", "last_frame"]},
        "must_preserve": {"type": "array", "items": {"type": "string"}},
        "may_change": {"type": "array", "items": {"type": "string"}},
        "used_by": {"type": "array", "items": {"type": "string"}},
        "prompt_label": {"type": "string"},
        "anchor_time_ms": {"type": "integer", "minimum": 0},
        "frame_index": {"type": "integer", "minimum": 0}
      }
    }
  }
}
