{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.example/schemas/storyboard-board-plan.schema.json",
  "title": "Semantic storyboard board count decided before image generation",
  "type": "object",
  "required": ["schema_version", "task_id", "shots"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "task_id": {"type": "string", "minLength": 1},
    "shots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["shot_id", "board_count", "reason", "semantic_groups"],
        "properties": {
          "shot_id": {"type": "string", "minLength": 1},
          "board_count": {"type": "integer", "minimum": 1, "maximum": 4},
          "reason": {"type": "string", "minLength": 1},
          "semantic_groups": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4,
            "items": {
              "type": "object",
              "required": ["board_number", "start_seconds", "end_seconds", "semantic_purpose"],
              "properties": {
                "board_number": {"type": "integer", "minimum": 1, "maximum": 4},
                "start_seconds": {"type": "number", "minimum": 0},
                "end_seconds": {"type": "number", "exclusiveMinimum": 0},
                "semantic_purpose": {"type": "string", "minLength": 1}
              }
            }
          }
        }
      }
    }
  }
}
