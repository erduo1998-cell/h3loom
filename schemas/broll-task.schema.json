{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.example/schemas/broll-task.schema.json",
  "title": "SRT B-roll task",
  "type": "object",
  "required": ["schema_version", "task_id", "task_name", "source", "spec", "inheritance_policy", "variant_ledger", "shot_plan_approval", "storyboard_sample_approval", "storyboard_approval", "execution", "budget", "delivery"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "task_id": {"type": "string", "minLength": 1},
    "task_name": {"type": "string", "minLength": 1},
    "source": {
      "type": "object",
      "required": ["original_srt", "copied_srt", "sha256", "annotations", "inputs", "forbidden"],
      "properties": {
        "original_srt": {"type": "string", "minLength": 1},
        "copied_srt": {"const": "source.srt"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "annotations": {"type": "array", "items": {"type": "string"}},
        "inputs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["original", "copied", "sha256"],
            "properties": {
              "original": {"type": "string", "minLength": 1},
              "copied": {"type": "string", "minLength": 1},
              "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
            }
          }
        },
        "forbidden": {"type": "array", "items": {"type": "string"}}
      }
    },
    "spec": {
      "type": "object",
      "required": ["ratio", "resolution", "backend", "storyboard_backend"],
      "properties": {
        "ratio": {"enum": ["21:9", "16:9", "4:3", "1:1", "3:4", "9:16"]},
        "resolution": {"enum": ["768P", "4K"]},
        "provider": {"const": "autodl"},
        "backend": {"const": "autodl-comfy-h3"},
        "storyboard_backend": {"const": "codex-imagine"},
        "audio": {"type": "string", "minLength": 1},
        "production_contract": {"const": "agent-know-gold-v1"},
        "workflow_contract": {"const": "three-stage-four-panel-v1"},
        "provider_profile": {"const": "precision_keyframes"},
        "audio_policy": {"const": "sfx_only"},
        "draws_per_shot": {"enum": [1, 2]},
        "h3_anchor_images_per_shot": {
          "const": {"minimum": 3, "maximum": 5}
        },
        "h3_anchor_density_max_per_shot": {"const": 4.1},
        "h3_prompt_max_characters": {"const": 1600},
        "execution_order": {"const": "pipelined_single_generate_single_download"},
        "download_queue_capacity": {"const": 4},
        "expected_width": {"type": "integer", "minimum": 1},
        "expected_height": {"type": "integer", "minimum": 1}
      },
      "allOf": [
        {
          "if": {
            "properties": {"backend": {"const": "autodl-comfy-h3"}},
            "required": ["backend"]
          },
          "then": {
            "required": ["provider"],
            "properties": {"provider": {"const": "autodl"}}
          }
        },
        {
          "if": {
            "properties": {
              "production_contract": {"const": "agent-know-gold-v1"}
            },
            "required": ["production_contract"]
          },
          "then": {
            "required": [
              "workflow_contract",
              "provider_profile",
              "audio_policy",
              "draws_per_shot",
              "h3_anchor_images_per_shot",
              "h3_anchor_density_max_per_shot",
              "h3_prompt_max_characters",
              "execution_order",
              "download_queue_capacity",
              "expected_width",
              "expected_height"
            ],
            "properties": {
              "resolution": {"const": "4K"}
            }
          }
        }
      ]
    },
    "inheritance_policy": {
      "type": "object",
      "required": ["mode", "source_task_id"],
      "properties": {
        "mode": {"enum": ["resume", "regenerate", "additive", "replace", "fresh_redesign"]},
        "source_task_id": {"type": ["string", "null"]}
      }
    },
    "variant_ledger": {
      "type": "object",
      "required": ["approved_generate_set", "assets"],
      "properties": {
        "approved_generate_set": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "assets": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["asset_id", "disposition", "variant_role"],
            "properties": {
              "asset_id": {"type": "string", "minLength": 1},
              "shot_id": {"type": "string", "minLength": 1},
              "source_task_id": {"type": "string", "minLength": 1},
              "source_path": {"type": "string", "minLength": 1},
              "disposition": {"enum": ["retain", "replace", "additive", "archive-only"]},
              "variant_role": {"enum": ["primary", "backup", "superseded", "archive-only"]}
            }
          }
        }
      }
    },
    "shot_plan_approval": {
      "type": "object",
      "required": ["status", "approved_at", "approved_by"],
      "properties": {
        "status": {"enum": ["not_required", "pending", "approved"]},
        "approved_at": {"type": ["string", "null"]},
        "approved_by": {"enum": ["user", null]},
        "approval_source": {"const": "explicit_user_instruction"},
        "approval_scope": {"const": "visual_lock_and_shot_plan"},
        "review_bundle_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "inheritance_ledger_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "approved_generate_set": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "user_event_id": {"type": ["string", "null"], "minLength": 1},
        "artifacts": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "object",
            "required": ["role", "path", "sha256"],
            "properties": {
              "role": {"enum": ["visual_lock_json", "visual_lock_review", "shot_plan_json", "shot_plan_review"]},
              "path": {"type": "string", "minLength": 1},
              "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
            }
          }
        }
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "approved"}}, "required": ["status"]},
          "then": {"required": ["approval_source", "approval_scope", "review_bundle_sha256", "inheritance_ledger_sha256", "approved_generate_set", "artifacts"]}
        }
      ]
    },
    "storyboard_sample_approval": {
      "type": "object",
      "required": ["status", "approved_at", "approved_by"],
      "properties": {
        "status": {"enum": ["not_required", "pending", "approved"]},
        "approved_at": {"type": ["string", "null"]},
        "approved_by": {"enum": ["user", null]},
        "approval_source": {"const": "explicit_user_instruction"},
        "approval_scope": {"const": "representative_storyboard_sample"},
        "review_bundle_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "artifacts": {"type": "array"}
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "approved"}}, "required": ["status"]},
          "then": {"required": ["approval_scope", "review_bundle_sha256", "manifest_sha256", "artifacts"]}
        }
      ]
    },
    "storyboard_approval": {
      "type": "object",
      "required": ["status", "approved_at", "approved_by"],
      "properties": {
        "status": {"enum": ["pending", "approved"]},
        "approved_at": {"type": ["string", "null"]},
        "approved_by": {"enum": ["user", null]},
        "approval_source": {"const": "explicit_user_instruction"},
        "approval_scope": {"const": "full_storyboards_and_h3_prompts"},
        "review_bundle_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "artifacts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["shot_id", "role", "path", "sha256"],
            "properties": {
              "shot_id": {"type": "string", "minLength": 1},
              "role": {"enum": ["raw_board", "review_board", "imagine_prompt", "generation_image"]},
              "path": {"type": "string", "minLength": 1},
              "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
            }
          }
        }
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "approved"}}, "required": ["status"]},
          "then": {"required": ["approval_scope", "review_bundle_sha256", "manifest_sha256", "artifacts"]}
        }
      ]
    },
    "execution": {
      "type": "object",
      "required": ["mode"],
      "properties": {"mode": {"enum": ["estimate_only", "authorized"]}}
    },
    "budget": {
      "type": "object",
      "required": ["currency", "hard_limit", "estimated", "spent", "committed"],
      "properties": {
        "currency": {"const": "CNY"},
        "hard_limit": {"type": "number", "exclusiveMinimum": 0, "maximum": 50},
        "estimated": {"type": "number", "minimum": 0},
        "spent": {"type": "number", "minimum": 0},
        "committed": {"type": "number", "minimum": 0}
      }
    },
    "delivery": {
      "type": "object",
      "required": ["status", "human_review"],
      "properties": {
        "status": {"enum": ["planned", "human_review_pending", "accepted", "revision_requested"]},
        "human_review": {"enum": ["pending", "accepted"]}
      }
    }
  }
}
